{
    "files.autoSave": "onFocusChange",
    "editor.fontSize": 14,
    "cmake.configureOnOpen": true,
    "editor.fontFamily": "'Maple Mono NF CN ExtraLight', 'Maple Mono NF CN ExtraLight', 'Maple Mono NF CN ExtraLight'",

    "C_Cpp.intelliSenseEngine": "disabled",
    "ccls.completion.detailedLabel": true,
    "ccls.misc.compilationDatabaseDirectory": "build",
    "ccls.codeLens.enabled": false,
    //"ccls.launch.command": "D:/program/ccls/code",
    "ccls.launch.args": [
        "--init={\"clang\":{\"resourceDir\":\"C:/local/22\"}}"
    ],

    "cmake.debugConfig": {
        //"type": "lldb",
        "console": "externalTerminal",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        "args": []
    },
    "cmake.configureSettings": {
        //"CMAKE_TOOLCHAIN_FILE": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    "cmake.configureArgs": [
        "-DRF_USE_GTEST=ON",
        "-DQT_DEFAULT_MAJOR_VERSION=6",
        "-DQAPPLICATION_CLASS=QApplication"
    ],
    "cmake.options.statusBarVisibility": "visible",
    "cmake.generator": "Ninja",
    "editor.inlayHints.enabled": "off",
    "editor.unicodeHighlight.allowedLocales": {
        "ja": true,
        "zh-hant": true,
        "zh-hans": true
    }
}